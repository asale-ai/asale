{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Asale",
  "version": "0.1.3",
  "identifier": "com.asale.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:9173",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Asale",
        "width": 1100,
        "height": 720,
        "minWidth": 900,
        "minHeight": 600,
        "create": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://dl.asale.ai/updater/{{target}}/{{current_version}}"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEMyMjlFQUM0RjU5OEVCQ0MKUldUTTY1ajF4T29wd2dwUm5pTnJlNkxFWTM0NGpjR3dUa29kTk1zbHJqdm1KaUtodXpnNlFFWmwK"
    },
    "deep-link": {
      "desktop": {
        "schemes": [
          "asale"
        ]
      }
    }
  }
}