{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Asale",
  "version": "0.7.2",
  "identifier": "com.asale.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:9173",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Asale",
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "width": 1360,
        "height": 880,
        "minWidth": 900,
        "minHeight": 600,
        "create": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "shell": {
      "open": true
    },
    "deep-link": {
      "desktop": {
        "schemes": [
          "asale"
        ]
      }
    }
  }
}