# Build-time configuration.
#
# Copy to `.env` (gitignored). `scripts/package.sh` / `scripts/package.ps1` read
# this file; to build by hand, export it first:
#   set -a && . ./.env && set +a && pnpm tauri build
#
# Everything here is read at *compile* time (baked in via option_env!) and again
# at *run* time, where the same variable overrides whatever was baked in. The
# desktop app is launched by double-click and has no shell environment, so a
# release build has to carry these values inside the binary.

# ---------------------------------------------------------------- endpoints
# Required for a release build. Anything that is not loopback must be https/wss —
# the client validates this itself and refuses to talk to a remote host in the
# clear. Unset defaults to 127.0.0.1 (see core/src/config.rs), i.e. a build that
# only works against a local stack.
ASALE_SERVER_API=https://api.asale.ai
ASALE_GATEWAY_API=https://gw.asale.ai
ASALE_GATEWAY_WS=wss://gw.asale.ai/v1/ws

# Local consumer proxy port (the client's own; not exposed).
ASALE_PROXY_PORT=9787

# ---------------------------------------------------------------- gateway trust
# The gateway's quota authorization public key. REQUIRED to package a client that
# can sell: without it the client refuses to go on the market, because it cannot
# verify that a peer claiming to be the gateway is authorized — selling anyway
# would mean handing your Claude/Codex subscription quota to whoever asks.
# For local development, derive and synchronize it from asale-server/.env:
#   cd .. && set -a && . asale-server/.env && set +a
#   cargo run --manifest-path asale-server/Cargo.toml --bin config-check -- \
#     --sync-client-env=asale-client/.env
# Release packaging should inject the public key produced by the production
# ASALE_QUOTA_SIG_SEED, not reuse a local development key.
ASALE_QUOTA_PUBKEY=

# ---------------------------------------------------------------- signing
# Passphrase of the Tauri updater signing key (`asale-updater.key`, gitignored).
# Leave empty if the key has none. The key itself is not read from here — the
# packaging scripts read the file directly.
TAURI_SIGNING_PRIVATE_KEY_PASSWORD=

# Windows Authenticode (Azure Artifact Signing, formerly Trusted Signing). Unset →
# the installer is unsigned and SmartScreen warns about an unknown publisher; a
# *partial* set makes package.ps1 fail rather than ship an unsigned installer.
# Unrelated to the updater key above: that one is minisign, for auto-update only.
# Needs `cargo install artifact-signing-cli` plus .NET 8, Azure CLI and signtool.
#AZURE_ARTIFACT_SIGNING_ENDPOINT=https://wus2.codesigning.azure.net
#AZURE_ARTIFACT_SIGNING_ACCOUNT=
#AZURE_ARTIFACT_SIGNING_CERTIFICATE_PROFILE=
#AZURE_CLIENT_ID=
#AZURE_CLIENT_SECRET=
#AZURE_TENANT_ID=

# ---------------------------------------------------------------- OAuth
# Gemini — google-gemini/gemini-cli installed-app credentials. Required for
# Gemini OAuth login; the provider is disabled when either value is missing.
# Values are published in the gemini-cli source; they are not stored in this
# repo because GitHub push protection rejects committed OAuth secrets.
ASALE_OAUTH_CLIENT_ID_GEMINI=
ASALE_OAUTH_CLIENT_SECRET_GEMINI=

# Claude / Codex — optional overrides; public defaults ship in daemon/src/oauth.rs.
#ASALE_OAUTH_CLIENT_ID_CLAUDE=
#ASALE_OAUTH_CLIENT_ID_CODEX=

# ------------------------------------------------------- internal features
# Custom endpoints: an OpenAI-compatible base URL + key, sold as if it were a
# subscription. Platform machinery for putting supply behind models the
# subscription sellers do not cover — not a seller feature, so it is off unless
# this is set. Off: the four `*_custom_endpoint*` commands are refused and the
# sidebar tab is not rendered at all. Accepts 1 / true / yes.
#ASALE_CUSTOM_ENDPOINTS=1
